{
  "name": "validex-desktop",
  "productName": "Validex",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "npm@11.7.0",
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "frontend:typecheck": "node frontend/scripts/typecheck.mjs",
    "frontend:build": "node frontend/scripts/build.mjs",
    "frontend:test": "npm run frontend:build && node frontend/scripts/run-unit-suite.mjs",
    "frontend:dev": "node frontend/scripts/dev.mjs --host 127.0.0.1 --port 34116",
    "electron:typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:test": "npm run electron:build && node --test electron/dist/*.test.js scripts/*.test.mjs",
    "electron:start": "node scripts/start-electron.mjs",
    "electron:dev": "npm run electron:build && node scripts/start-electron.mjs --dev-url=http://127.0.0.1:34116",
    "typecheck": "npm run frontend:typecheck && npm run electron:typecheck",
    "build": "npm run frontend:build && npm run electron:build",
    "test": "npm run frontend:test && npm run electron:test",
    "postinstall": "node node_modules/electron/install.js",
    "start": "node scripts/start-electron.mjs"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "typescript": "5.9.3"
  }
}
